                      "revision": 1
                    }
                  }
                ]
              }
            ]
          },
          {
            "tag": "column",
            "width": "auto",
            "elements": [
              {
                "tag": "button",
                "type": "text",
                "size": "small",
                "text": {
                  "tag": "plain_text",
                  "content": "移除"
                },
                "behaviors": [
                  {
                    "type": "callback",
                    "value": {
                      "action": "remove",
                      "token": "example-non-executable-token",
                      "revision": 1
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
